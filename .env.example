# Grocery Store Management System Environment Configuration

# Optional: Google Apps Script Web App Deployment URL
# If left blank, the application automatically runs in Offline / Local Demo Mode
# with pre-seeded grocery products, suppliers, customers, and instant response times.
VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycby_REPLACE_WITH_YOUR_DEPLOYMENT_ID/exec

# Currency display preference (PKR is default)
VITE_DEFAULT_CURRENCY=PKR
VITE_DEFAULT_CURRENCY_SYMBOL=Rs.
